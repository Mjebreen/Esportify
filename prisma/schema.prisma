// ─────────────────────────────────────────────────────────────────────────────
// Esportify — Phase 1 schema (multi-tenant foundation).
// Stack: Next.js (App Router) + TypeScript, PostgreSQL, Prisma, NextAuth (Auth.js).
//
// Isolation = THREE layers:
//   1. Request context (AsyncLocalStorage) holds the resolved orgId.
//   2. Query layer: every read/write runs inside a tx that issues
//      `SET LOCAL app.current_org_id = <orgId>` and is org-scoped.
//   3. Postgres RLS floor: FORCE ROW LEVEL SECURITY on every tenant table,
//      app_runtime is NOBYPASSRLS. Defined in prisma/sql/ (committed migration).
//
// Cross-tenant FK integrity: Prisma can't reuse `organizationId` across two
// relations, so relations here are single-column for clean generation, and the
// composite (organizationId, id) FK *guards* are added in prisma/sql/10_security.sql
// (Section B). Each FK-target model carries @@unique([organizationId, id]) for them.
//
// RBAC is DATA, not code: Permission × Role × RolePermission, resolved by authorize().
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // app_runtime: NON-superuser, NOBYPASSRLS
  directUrl  = env("DIRECT_URL")   // migration/owner role
  extensions = [pgcrypto, citext]
}

// ─────────────────────────── ENUMS ───────────────────────────
enum SystemRole {
  SUPER_ADMIN
  IT
  LEADERSHIP
  MANAGER
  PLAYER
  MARCOM
  AVIATION
  MERCH
  FINANCE
} // seed/UI hint ONLY — nothing in authorize() gates on this.

enum DepartmentType {
  ESPORTS
  MANAGEMENT
  MARCOM
  AVIATION
  MERCH
  IT
  FINANCE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlayerStatus {
  ACTIVE
  BENCHED
  INACTIVE
  TRIAL
  FORMER
}

enum PermissionEffect {
  ALLOW
  DENY
} // DENY reserved; Phase 1 seeds ALLOW only.

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
  LOGIN
  LOGOUT
  PERMISSION_GRANT
  PERMISSION_REVOKE
  MODULE_TOGGLE
  EXPORT
}

enum MediaVisibility {
  PRIVATE
  ROSTER
  ORG_INTERNAL
  RESTRICTED
}

enum MediaOwnerType {
  PLAYER
  MANAGER
  USER
  ORGANIZATION
  ROSTER
  GAME_TITLE
  TOURNAMENT // reserved (P3)
  CONTRACT // reserved (P3)
  TRIP // reserved (P4)
  REQUEST // reserved (P2)
}

enum MediaStatus {
  PENDING // not servable until the validation Lambda flips to READY
  READY
  QUARANTINED
}

enum ModuleKey {
  CORE
  REQUESTS
  TASKS
  CALENDAR
  TOURNAMENTS
  CONTRACTS
  SALARIES
  ATTENDANCE
  PERFORMANCE
  MERCH
  PLAYER_PORTAL
  MARCOM
  AVIATION
  ROSTER_CALCULATOR
}

// ─────────────────────────── TENANT ROOT ───────────────────────────
model Organization {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String       @unique @db.Citext
  name          String
  legalName     String?
  defaultLocale String       @default("en") // "ar-SA" | "en"
  defaultDir    String       @default("ltr") // "rtl" | "ltr"
  timezone      String       @default("UTC")
  country       String? // ISO-3166 alpha-2, e.g. "SA"
  status        EntityStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  memberships Membership[]
  roles       Role[]
  rolePerms   RolePermission[]
  departments Department[]
  gameTitles  GameTitle[]
  rosters     Roster[]
  players     Player[]
  managers    Manager[]
  modules     OrgModule[]
  media       MediaAsset[]
  auditLogs   AuditLog[]
  // Phase 2
  requests      Request[]
  tasks         Task[]
  comments      Comment[]
  notifications Notification[]
  // Phase 3
  tournaments     Tournament[]
  contracts       Contract[]
  contractClauses ContractClause[]
  salaries        Salary[]
  attendance      Attendance[]
  performance     PerformanceRecord[]
  bootcamps       Bootcamp[]
  schedules       Schedule[]
  merchProfiles   MerchSizeProfile[]
  jerseyGrants    JerseyEntitlement[]
  // Phase 4
  trips    Trip[]
  flights  FlightOption[]
  invoices Invoice[]

  @@index([status])
  @@map("organizations")
}

// ─────────────────────────── IDENTITY (global, RLS-exempt) ───────────────────────────
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  emailVerified   DateTime?
  name            String?
  image           String?
  locale          String?
  passwordHash    String? // Credentials provider (bcrypt). Null for invite-pending users.
  isPlatformStaff Boolean   @default(false) // Esportify ops; cross-tenant access is a separate, audited path — NOT a tenant role.
  clerkUserId     String?   @unique // populated only if Clerk is ever adopted.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  players     Player[] // one-to-many: at most one per org (enforced on Player).
  managers    Manager[]
  auditLogs   AuditLog[]   @relation("AuditActor")
  uploads     MediaAsset[] @relation("MediaUploader")
  // Phase 2
  requestsRequested Request[]      @relation("RequestRequester")
  requestsAssigned  Request[]      @relation("RequestAssignee")
  tasksCreated      Task[]         @relation("TaskCreator")
  tasksAssigned     Task[]         @relation("TaskAssignee")
  comments          Comment[]      @relation("CommentAuthor")
  notifications     Notification[] @relation("NotificationUser")

  @@map("users")
}

// NextAuth/Auth.js adapter tables (forward-compat for OAuth/magic-link; Phase 1 uses Credentials+JWT).
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────── MEMBERSHIP (user ↔ org ↔ role) ───────────────────────────
model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleId         String           @db.Uuid
  departmentId   String?          @db.Uuid
  status         MembershipStatus @default(INVITED)
  isPrimary      Boolean          @default(false) // default org on login; partial-unique per user among live rows (raw migration).
  createdById    String?          @db.Uuid // FK to users added in raw migration (onDelete SET NULL).
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, roleId]) // a user may hold several roles in one org (multi-role union).
  @@index([organizationId, status])
  @@index([userId])
  @@map("memberships")
}

// ─────────────────────────── RBAC (data-driven) ───────────────────────────
model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String // "player" | "manager" | "role" | "rolePermission" | "membership" | ...
  action      String // "create" | "read" | "update" | "delete" | "manage"
  key         String           @unique // "player:update" — stable display key
  description String?
  grants      RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model Role {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  slug           String      @db.Citext // per-org; partial-unique among live rows (raw migration).
  name           String
  systemRole     SystemRole? // seed/UI hint only.
  isSystem       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grants       RolePermission[]
  memberships  Membership[]

  @@unique([organizationId, id]) // composite-FK target.
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  roleId         String           @db.Uuid
  permissionId   String           @db.Uuid
  scope          String // "own" | "roster" | "department" | "organization"
  effect         PermissionEffect @default(ALLOW)
  phase          Int              @default(1) // ENFORCED: a grant with phase > DEPLOYED_PHASE is inert.
  constraints    Json? // e.g. { fields: [...] } self-edit allowlist, redaction denylist.
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, roleId, permissionId, scope])
  @@index([organizationId, roleId])
  @@map("role_permissions")
}

// ─────────────────────────── ORG STRUCTURE ───────────────────────────
model Department {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  type           DepartmentType
  name           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  requests     Request[] // requests routed to this department (Phase 2)

  @@unique([organizationId, id])
  @@unique([organizationId, type]) // one dept per type per org (relaxable later).
  @@index([organizationId])
  @@map("departments")
}

model GameTitle {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  slug           String    @db.Citext // "valorant" — partial-unique among live rows (raw migration).
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rosters      Roster[]
  tournaments  Tournament[] // Phase 3

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("game_titles")
}

model Manager {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid // nullable: a manager may exist before having a login.
  firstName      String
  lastName       String
  email          String?      @db.Citext
  status         EntityStatus @default(ACTIVE)
  createdById    String?      @db.Uuid
  updatedById    String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  rosters      Roster[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId]) // one Manager profile per user per org.
  @@index([organizationId, status])
  @@map("managers")
}

model Roster {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  gameTitleId    String    @db.Uuid
  managerId      String?   @db.Uuid // single source of truth for "manager owns these players".
  name           String
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gameTitle    GameTitle    @relation(fields: [gameTitleId], references: [id], onDelete: Restrict)
  manager      Manager?     @relation(fields: [managerId], references: [id], onDelete: SetNull)
  players      Player[]
  tournaments  Tournament[] // Phase 3
  schedules    Schedule[] // Phase 3

  @@unique([organizationId, id])
  @@index([organizationId, managerId])
  @@index([organizationId, gameTitleId])
  @@map("rosters")
}

model Player {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  rosterId       String?      @db.Uuid // null = unrostered/trial (org-level, not manager-owned yet).
  userId         String?      @db.Uuid
  firstName      String
  lastName       String
  inGameName     String       @db.Citext // partial-unique [orgId, inGameName] among live rows (raw migration).
  email          String?      @db.Citext
  phone          String?
  dateOfBirth    DateTime?
  jerseyNumber   Int?
  status         PlayerStatus @default(ACTIVE)
  createdById    String?      @db.Uuid
  updatedById    String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roster       Roster?      @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Phase 3/4 — Player is the gravity well.
  contracts     Contract[]
  salaries      Salary[]
  attendance    Attendance[]
  performance   PerformanceRecord[]
  merchProfiles MerchSizeProfile[]
  jerseyGrants  JerseyEntitlement[]
  trips         Trip[]
  invoices      Invoice[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId]) // one Player profile per user per org.
  @@index([organizationId, status])
  @@index([organizationId, rosterId])
  @@map("players")
}

// ─────────────────────────── MODULE TOGGLES ───────────────────────────
model OrgModule {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  module         ModuleKey
  enabled        Boolean   @default(false)
  config         Json?
  updatedById    String?   @db.Uuid
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module])
  @@map("org_modules")
}

// ─────────────────────────── MEDIA (S3) ───────────────────────────
model MediaAsset {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  s3Key          String          @unique // never a public URL; convention: org/<orgId>/...
  contentType    String
  sizeBytes      BigInt
  status         MediaStatus     @default(PENDING) // not servable until READY.
  ownerType      MediaOwnerType
  ownerId        String          @db.Uuid // polymorphic (no FK by design).
  rosterId       String?         @db.Uuid // denormalized for ROSTER-scope authz on player media.
  visibility     MediaVisibility @default(PRIVATE)
  tags           String[]
  uploadedById   String?         @db.Uuid
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, ownerType, ownerId])
  @@index([organizationId, rosterId])
  @@map("media_assets")
}

// ─────────────────────────── AUDIT (append-only, immutable) ───────────────────────────
// INSERT-only for app_runtime (UPDATE/DELETE revoked in raw migration). Reads org-scoped,
// RBAC-gated to Super Admin / IT / Leadership. before/after are redacted at WRITE time.
model AuditLog {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  actorUserId    String?     @db.Uuid
  action         AuditAction
  entity         String // model name
  entityId       String?     @db.Uuid
  subjectType    String? // optional denormalized subject for filtering, e.g. "PLAYER"
  subjectId      String?     @db.Uuid
  before         Json? // redacted at write time (per-entity denylist)
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entity, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2 — Request Engine · Tasks · Comments · Notifications (the "Asana" glue)
// ═══════════════════════════════════════════════════════════════════════════

enum RequestType {
  TECHNICAL_SERVICE
  PHOTOGRAPHY
  SPECIAL
  TRAVEL
  MERCH
  GENERAL
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  REQUEST_ASSIGNED
  REQUEST_STATUS
  TASK_ASSIGNED
  TASK_STATUS
  COMMENT
  CONTRACT_EXPIRY
  GENERIC
}

model Request {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String        @db.Uuid
  type               RequestType
  title              String
  description        String?
  status             RequestStatus @default(NEW)
  priority           Priority      @default(MEDIUM)
  requesterUserId    String        @db.Uuid
  assigneeUserId     String?       @db.Uuid
  targetDepartmentId String?       @db.Uuid
  dueDate            DateTime?
  payload            Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester        User         @relation("RequestRequester", fields: [requesterUserId], references: [id])
  assignee         User?        @relation("RequestAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  targetDepartment Department?  @relation(fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  comments         Comment[]
  tasks            Task[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, targetDepartmentId])
  @@index([organizationId, assigneeUserId])
  @@map("requests")
}

model Task {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String     @db.Uuid
  title            String
  description      String?
  status           TaskStatus @default(TODO)
  priority         Priority   @default(MEDIUM)
  creatorUserId    String     @db.Uuid
  assigneeUserId   String?    @db.Uuid
  dueDate          DateTime?
  relatedRequestId String?    @db.Uuid
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("TaskCreator", fields: [creatorUserId], references: [id])
  assignee       User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  relatedRequest Request?     @relation(fields: [relatedRequestId], references: [id], onDelete: SetNull)
  comments       Comment[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, assigneeUserId])
  @@map("tasks")
}

model Comment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  authorUserId   String   @db.Uuid
  body           String
  requestId      String?  @db.Uuid
  taskId         String?  @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("CommentAuthor", fields: [authorUserId], references: [id])
  request      Request?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, requestId])
  @@index([organizationId, taskId])
  @@map("comments")
}

model Notification {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String?
  entityType     String?
  entityId       String?          @db.Uuid
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3 — Manager Workspace modules
// ═══════════════════════════════════════════════════════════════════════════

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum AttendanceType {
  ABSENCE
  TARDINESS
}

enum ScheduleType {
  PRACTICE
  SCRIM
  MEETING
  REVIEW
}

model Tournament {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  gameTitleId    String           @db.Uuid
  rosterId       String?          @db.Uuid
  name           String
  status         TournamentStatus @default(UPCOMING)
  startDate      DateTime
  endDate        DateTime?
  placement      Int?
  prizePool      Decimal?         @db.Decimal(14, 2)
  prizeCurrency  String?
  notes          String?
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gameTitle    GameTitle    @relation(fields: [gameTitleId], references: [id], onDelete: Restrict)
  roster       Roster?      @relation(fields: [rosterId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, startDate])
  @@index([organizationId, rosterId])
  @@map("tournaments")
}

model Contract {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  playerId       String         @db.Uuid
  status         ContractStatus @default(DRAFT)
  startDate      DateTime
  endDate        DateTime
  salaryAmount   Decimal?       @db.Decimal(14, 2)
  currency       String         @default("SAR")
  buyout         Decimal?       @db.Decimal(14, 2)
  prizeSplitPct  Decimal?       @db.Decimal(5, 2) // tournament prize % to player before transfer
  notes          String?
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  player       Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clauses      ContractClause[]

  @@unique([organizationId, id])
  @@index([organizationId, playerId])
  @@index([organizationId, endDate])
  @@map("contracts")
}

model ContractClause {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  contractId     String   @db.Uuid
  title          String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([organizationId, contractId])
  @@map("contract_clauses")
}

model Salary {

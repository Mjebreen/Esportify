// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4 — Travel · Billing
// ═══════════════════════════════════════════════════════════════════════════

enum TripStatus {
  REQUESTED
  BOOKED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED // player uploaded → awaiting manager approval
  MANAGER_APPROVED // manager approved → with finance
  REJECTED // manager rejected
  SENT
  PAID // finance paid
  OVERDUE
  VOID
}

model Trip {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @db.Uuid
  playerId       String?    @db.Uuid
  rosterId       String?    @db.Uuid
  purpose        String
  origin         String?
  destination    String?
  departAt       DateTime?
  returnAt       DateTime?
  status         TripStatus @default(REQUESTED)
  notes          String?
  createdById    String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  player       Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)
  flights      FlightOption[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, playerId])
  @@map("trips")
}

model FlightOption {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  tripId         String    @db.Uuid
  airline        String?
  flightNo       String?
  departAt       DateTime?
  arriveAt       DateTime?
  price          Decimal?  @db.Decimal(12, 2)
  currency       String?
  selected       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trip         Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([organizationId, tripId])
  @@map("flight_options")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid
  playerId       String        @db.Uuid
  number         String
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("SAR")
  status         InvoiceStatus @default(SENT)
  issuedAt       DateTime
  dueAt          DateTime?
  paidAt         DateTime?
  notes          String?
  createdById    String?       @db.Uuid // the submitter (player, for uploaded invoices)
  approvedById   String?       @db.Uuid // the manager who approved
  approvedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  player       Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([organizationId, playerId, status])
  @@map("invoices")
}

# ─────────────────────────────────────────────────────────────────────────────
# Esportify — environment template. Copy to `.env` and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Two roles by design (defense in depth):
#   - DATABASE_URL  -> app_runtime: a NON-superuser, NOBYPASSRLS role. RLS applies to it.
#   - DIRECT_URL    -> migration/owner role used by `prisma migrate`. May own tables.
# Local dev shortcut: you can point both at the same superuser, but then RLS does NOT
# bind (a superuser bypasses RLS). For a faithful local security posture, create the
# app_runtime role per prisma/sql/00_roles.sql and use it in DATABASE_URL.
DATABASE_URL="postgresql://app_runtime:app_pw@localhost:5432/esportify?schema=public"
DIRECT_URL="postgresql://esportify_owner:owner_pw@localhost:5432/esportify?schema=public"

# Separate database for the isolation test suite (it truncates/seeds aggressively).
TEST_DATABASE_URL="postgresql://app_runtime:app_pw@localhost:5432/esportify_test?schema=public"

# Auth.js (NextAuth v5). Generate: `npx auth secret`  (or openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# In prod set AUTH_URL to the deployed origin.
AUTH_URL="http://localhost:3000"

# AWS — region locked to me-central-1 (UAE) for KSA/PDPL data residency.
AWS_REGION="me-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Private bucket (Block Public Access ON, BucketOwnerEnforced). Media is only ever
# reachable via short-lived presigned URLs minted after an authorization check.
S3_MEDIA_BUCKET="esportify-media-dev"
S3_PRESIGN_EXPIRY_SECONDS="120"

# Default deployed phase. The authorize() gate refuses any grant whose phase > this,
# so forward-declared P3/P4 grants stay inert until you bump this.
DEPLOYED_PHASE="4"
